# Copy this file to .env beside compose.yaml.
# Set this to the exact address that every phone will open.
PUBLIC_ORIGIN=http://192.168.1.50:8080
ALLOW_INSECURE_HTTP=true

# latest receives each stable release; use 0.1.0 to pin a version.
MTG_IMAGE=ghcr.io/addison16/mtg-util:latest

# For HTTPS behind one reverse proxy, use these settings instead:
# PUBLIC_ORIGIN=https://table.example.com
# ALLOW_INSECURE_HTTP=false
# TRUST_PROXY_HOPS=1
TRUST_PROXY_HOPS=0
ROOM_TTL_DAYS=30
SESSION_TTL_DAYS=90
