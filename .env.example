# Development: npm run dev uses one browser origin through the Vite proxy.
PUBLIC_ORIGIN=http://localhost:5173
ALLOW_INSECURE_HTTP=true
PORT=8080
DATA_DIR=.mtg-data
ROOM_TTL_DAYS=30
SESSION_TTL_DAYS=90
TRUST_PROXY_HOPS=0
# Production: PUBLIC_ORIGIN=https://table.example.com
# ALLOW_INSECURE_HTTP=false
# TRUST_PROXY_HOPS=1   (only when exactly one trusted reverse proxy is in front)
# For Docker, use .env.docker.example instead.
